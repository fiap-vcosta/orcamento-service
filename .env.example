ASPNETCORE_ENVIRONMENT=Development

# Firestore (Compose host 8087 → firestore:8080)
FIRESTORE_PROJECT_ID=local-orcamento
FIRESTORE_EMULATOR_HOST=127.0.0.1:8087
Firestore__ProjectId=local-orcamento
# Emulador local: (default). GCP: orcamento
Firestore__DatabaseId=(default)

# Pub/Sub (Compose host 8088 → pubsub:8085)
PUBSUB_PROJECT_ID=local-orcamento
PUBSUB_EMULATOR_HOST=127.0.0.1:8088
PubSub__ProjectId=local-orcamento
PubSub__UseInMemory=false
PubSub__EnableWorkers=true

# Mercado Pago (sandbox) — nunca commitar valores reais
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MercadoPago__AccessToken=
MercadoPago__WebhookSecret=
MercadoPago__BaseUrl=https://api.mercadopago.com
MercadoPago__ExpirationTime=PT60S

# PAT GitHub com read:packages (docker build / restore do building-blocks)
NUGET_AUTH_TOKEN=

DD_API_KEY=
DD_SITE=datadoghq.com
